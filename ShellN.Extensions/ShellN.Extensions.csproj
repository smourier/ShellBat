<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\nuget</PackageOutputPath>

		<Version>1.0.5</Version>
		<ProductVersion>1.0.5</ProductVersion>
		<FileVersion>1.0.5</FileVersion>
		<InformationalVersion>1.0.5</InformationalVersion>
		<SourceRevisionId>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
		<Authors>Simon Mourier</Authors>
		<Copyright>Copyright (c) 2025-2026 Simon Mourier</Copyright>
		<Description>A friendly, AOT compatible thin managed layer over some of the Windows Shell namespace APIs, on top of ShellN. Browse and operate the shell as objects with ShellItem, ShellFolder and KnownFolder, invoke the real context menu, read property stores, and watch for shell changes.</Description>
		<PackageId>ShellN.Extensions</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/smourier/ShellBat</PackageProjectUrl>
		<RepositoryUrl>https://github.com/smourier/ShellBat</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>windows;shell;namespace;IShellItem;ShellItem;context-menu;AOT;DirectN</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\ShellN\Properties\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Hashing" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShellN\ShellN.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DirectNAot" Version="1.6.5" />
		<PackageReference Include="DirectNAot.Extensions" Version="1.6.5" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="DirectN" />
		<Using Include="DirectN.Extensions" />
		<Using Include="DirectN.Extensions.Com" />
		<Using Include="DirectN.Extensions.Utilities" />
		<Using Include="ShellN" />
		<Using Include="ShellN.Extensions" />
		<Using Include="ShellN.Extensions.Utilities" />
		<Using Include="System" />
		<Using Include="System.Collections" />
		<Using Include="System.Collections.Concurrent" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.ComponentModel" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Globalization" />
		<Using Include="System.IO" />
		<Using Include="System.IO.Hashing" />
		<Using Include="System.Linq" />
		<Using Include="System.Numerics" />
		<Using Include="System.Reflection" />
		<Using Include="System.Runtime.Versioning" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="System.Text" />
		<Using Include="System.Threading" />
		<Using Include="System.Threading.Tasks" />
	</ItemGroup>

</Project>
